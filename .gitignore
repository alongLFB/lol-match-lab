# Node 依赖
node_modules/
package-lock.json

# 环境变量与敏感配置
.env
.env.*
!.env.example
data/settings.json
data/last-summoner.json

# 运行时数据与用户缓存（避免提交海量对局快照及个人战绩）
data/matches/
data/spectate/
data/ai/
data/assets/
data/lists/
data/innerwar.json
data/*.tmp
*.tmp

# 保留配置模板与核心数据目录
!data/settings.example.json
!data/static/

# 系统临时文件
.DS_Store
Thumbs.db
desktop.ini

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建与打包输出
build/
dist/
*.spec
app.ico
__pycache__/
*.py[cod]
